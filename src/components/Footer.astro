---
import { Image } from 'astro:assets';
import logo from '../assets/img/logo-a.png'; // logo BNI con la «A», da confermare (vedi TESTI-INVENTATI.md)
import { site, footerMenu, legale } from '../data/landing';

// Solo i social che esistono davvero: finche' l'URL e' un segnaposto il link
// porterebbe a una pagina 404, quindi la colonna resta nascosta.
const social = [
  { nome: 'Instagram', url: site.social.instagram },
  { nome: 'Facebook', url: site.social.facebook },
].filter((s) => s.url.startsWith('http'));

// Anno dinamico: mai un anno scritto a mano nel footer.
const anno = new Date().getFullYear();
---

<footer class="bg-[var(--color-footer)] text-white/70">
  <div class="container-content grid gap-12 py-16 md:grid-cols-2 md:py-20 lg:grid-cols-[1.4fr_1fr_1fr]">
    <div class="max-w-md">
      <Image
        src={logo}
        alt={`Logo ${site.nome}`}
        widths={[191, 382]}
        sizes="191px"
        class="h-auto w-[170px] brightness-0 invert"
        loading="lazy"
      />
      <p class="mt-6 text-[15px] leading-7">
        {/* INVENTATO */}
        Architetto d’interni in provincia di Bergamo. Case, piccoli spazi, uffici e
        outdoor, dal rilievo al cantiere.
      </p>
    </div>

    <nav aria-label="Menu del sito">
      <h2 class="eyebrow mb-5 text-white/60">{/* INVENTATO */}Naviga</h2>
      <ul class="flex flex-col gap-2.5 text-[15px]">
        {footerMenu.map((item) => (
          <li>
            <a href={item.href} class="transition-colors hover:text-[var(--color-brand)]">{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div>
      <h2 class="eyebrow mb-5 text-white/60">{/* INVENTATO */}Contatti</h2>
      <address class="flex flex-col gap-2.5 text-[15px] not-italic">
        <span>{site.indirizzo}</span>
        <a href={`tel:${site.telefonoE164}`} class="transition-colors hover:text-[var(--color-brand)]">
          {site.telefono}
        </a>
        <a href={`mailto:${site.email}`} class="transition-colors hover:text-[var(--color-brand)]">
          {site.email}
        </a>
      </address>

      {social.length > 0 && (
        <>
          <h2 class="eyebrow mt-8 mb-4 text-white/60">{/* INVENTATO */}Social</h2>
          <ul class="flex gap-5 text-[15px]">
            {social.map((s) => (
              <li>
                <a href={s.url} rel="noopener noreferrer" target="_blank" class="transition-colors hover:text-[var(--color-brand)]">{s.nome}</a>
              </li>
            ))}
          </ul>
        </>
      )}
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="container-content flex flex-col gap-3 py-6 text-[13px] sm:flex-row sm:items-center sm:justify-between">
      <p>© {anno} {legale.ragioneSociale} — P. IVA {legale.piva} — PEC {legale.pec}</p>
      <a href="/privacy-policy/" class="transition-colors hover:text-[var(--color-brand)]">
        Privacy Policy &amp; Cookie Policy
      </a>
    </div>
  </div>
</footer>
